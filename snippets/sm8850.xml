<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <!-- SM8850 (kaanapali) CAF additions -->

  <!-- Override hardware/qcom-caf/common to use SM8850-aware fork -->
  <remove-project name="LineageOS/android_hardware_qcom-caf_common" />
  <project path="hardware/qcom-caf/common" name="OnePlus-SM8850-Development/android_hardware_qcom-caf_common" groups="qcom">
    <linkfile src="os_pickup_aosp.mk" dest="hardware/qcom/Android.mk" />
    <linkfile src="os_pickup_sepolicy_vndr.mk" dest="device/qcom/sepolicy_vndr/SEPolicy.mk" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/msm8953/Android.bp" />
    <linkfile src="os_pickup.bp" dest="hardware/qcom-caf/msm8998/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sdm660/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sdm845/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8150/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8250/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8350/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8450/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8450-6.6/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8550/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8650/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8750/Android.bp" />
    <linkfile src="os_pickup_qssi.bp" dest="hardware/qcom-caf/sm8850/Android.bp" />
  </project>

  <!-- SM8850 sepolicy vendor -->
  <project path="device/qcom/sepolicy_vndr/sm8850" name="OnePlus-SM8850-Development/android_device_qcom_sepolicy_vndr" groups="qcom,kaanapali-vendor" revision="lineage-23.2-caf-sm8850" />

  <!-- SM8850 audio -->
  <project path="hardware/qcom-caf/sm8850/audio/primary-hal" name="OnePlus-SM8850-Development/android_hardware_qcom_audio-ar" groups="qcom,kaanapali-audio" revision="lineage-23.2-caf-sm8850" />

  <!-- SM8850 thermal (overrides the LineageOS one) -->
  <remove-project name="LineageOS/android_hardware_qcom_thermal" />
  <project path="hardware/qcom-caf/thermal" name="OnePlus-SM8850-Development/android_hardware_qcom_thermal" groups="qcom,kaanapali-vendor" />

  <!-- SM8850 USB -->
  <remove-project name="LineageOS/android_vendor_qcom_opensource_usb" />
  <project path="vendor/qcom/opensource/usb" name="OnePlus-SM8850-Development/android_vendor_qcom_opensource_usb" groups="qcom,kaanapali-vendor" />

</manifest>
